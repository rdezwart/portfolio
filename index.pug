extends layouts/_sidebar

append vars
  -
    title = "Portfolio"
    slug = "home"
    description = "Hi, I'm Robin de Zwart; I've grown a deep fascination with machine learning and artificial " +
            "intelligence and have been steadily building my skills and knowledge over the past few years. :]"
    grid = "pre-sidebar";

block url
  meta(property="og:url" content="https://rdezwart.ca/")


append pre-sidebar
  section#intro
    h1 Welcome, I'm #[+name(false)]
    p Hello world lorem ipsum

append sidebar-content
  +sidebar({heading: "Skills"})(class="sticky")
    include inc/_skills

append content
  section#projects
    +h(2, "Featured Projects")

    ul.project-grid(role="list")
      each p in projects
        +project-card(p)
