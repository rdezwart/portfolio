extends layouts/_default

append vars
  -
    title = "Portfolio"
    slug = "home"
    description = "Hi, I'm Robin de Zwart; I've grown a deep fascination with machine learning and artificial " +
            "intelligence and have been steadily building my skills and knowledge over the past few years. :]"
    layout = "project";

block url
  meta(property="og:url" content="https://rdezwart.ca/")

append scripts
  script(src="/js/toc.js" defer)
  script(src="https://cdn.jsdelivr.net/npm/p5@1.11.11/lib/p5.min.js" defer)
  script(src="/js/automata.js" defer)


append sidebar
  +sidebar("Skills")
    include inc/_skills

prepend main
  //- Needs to be a div because we can't have two header sections on one page.
  div.header
    section
      h1
        | Hi, I'm
        |
        +name(false)
    div.gradient


append content
  section#projects
    +h(2, "Featured Projects")

    div#automata

    ul.project-grid(role="list")
      each p in projects
        +project-card(p)
