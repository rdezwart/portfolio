extends layouts/_default

append vars
  -
    title = "Portfolio"
    slug = "home"
    description = "Hi, I'm Robin de Zwart; I've grown a deep fascination with machine learning and artificial " +
            "intelligence and have been steadily building my skills and knowledge over the past few years. :]"

block url
  meta(property="og:url" content="https://rdezwart.ca/")

append scripts
  script(src="/js/toc.js" defer)

append sidebar
  +sidebar("Skills")
    p Here's a list of my skills lmao

  +sidebar("About")
    p i'm moving this to its own page

append content
  section
    h1
      | Hi, I'm
      |
      +name()
    p
      | I've grown a deep fascination with machine learning and artificial intelligence and have been steadily building my
      | skills and knowledge over the past few years. :]
    p
      | I'm nearing completion of a B.Sc. with a primary concentration on #[strong AI and Data Science for Human-Centered Systems]
      | at #[a.link(href="https://www.sfu.ca/siat.html" target="_blank" rel="noreferrer") SFU's School of Interactive Arts &amp; Technology].
      | I have also gained experience in web/mobile development, various programming languages, and game design through
      | completing additional concentrations.
    p
      | I will graduate later this year and am eager to gain hands-on experience diving deeper into the training,
      | fine-tuning, implementation, and ethical considerations of LLMs, generative models, and artificial intelligence as
      | a whole.

  section#projects
    +h(2, "Featured Projects")

    div.project-grid
      div.project-card
        a.img-link(href="/img/autolume-gallery/canvas-2.webp" target="_blank")
          img.img(src="/img/autolume-gallery/canvas-1.webp" loading="lazy" width="1024" height="1024"
            alt="A composition saved from AutolumeGallery, primarily oranges and whites.")
        ul.nav-list
          +nav-item("AI + VR", "AutolumeGallery", "/projects/autolume-gallery.html", projects.AutolumeGallery.description)

      div.project-card
        a.img-link(href="/img/autolume-gallery/canvas-3.webp" target="_blank")
          img.img(src="/img/autolume-gallery/canvas-1.webp" loading="lazy" width="1024" height="1024"
            alt="A composition saved from AutolumeGallery, primarily oranges and whites.")
        ul.nav-list
          +nav-item("AI + VR", "AutolumeGallery", "/projects/autolume-gallery.html", projects["Food Identifier"].description)

      div.project-card
        a.img-link(href="/img/autolume-gallery/canvas-1.webp" target="_blank")
          img.img(src="/img/autolume-gallery/canvas-1.webp" loading="lazy" width="1024" height="1024"
            alt="A composition saved from AutolumeGallery, primarily oranges and whites.")
        ul.nav-list
          +nav-item("AI + VR", "AutolumeGallery", "/projects/autolume-gallery.html", projects["A Sight Never Seen"].description)


      div.project-card
        a.img-link(href="/img/autolume-gallery/canvas-1.webp" target="_blank")
          img.img(src="/img/autolume-gallery/canvas-1.webp" loading="lazy" width="1024" height="1024"
            alt="A composition saved from AutolumeGallery, primarily oranges and whites.")
        ul.nav-list
          +nav-item("AI + VR", "AutolumeGallery", "/projects/autolume-gallery.html", projects.AutolumeGallery.description)
