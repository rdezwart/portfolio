extends layouts/_sidebar

append vars
  -
    title = "Portfolio"
    slug = "home"
    grid = "pre-sidebar";

block url
  meta(property="og:url" content="https://rdezwart.ca/")


append pre-sidebar
  section#intro
    div.hgroup
      h1.h1 Welcome, I'm #[+name({full: false})]
      p.secondary.
        I'm a multi-disciplinary developer with a love for creating interactive experiences and telling stories.
    p.
      Please note, this site is currently under #[strong active construction], so you may find content that is not yet
      finished.
    p.
      If you're here this early, it's great to have you! I am currently looking for work, please feel free to reach out
      to me if you have any questions or inquiries. :]
append sidebar-content
  +sidebar({heading: "Skills"})(class="sticky")
    include inc/_skills

append content
  section#projects
    +h(2, "Featured Projects")

    ul.project-grid(role="list")
      each p in projects
        +project-card(p)
