extends layouts/_sidebar

append vars
  -
    title = "About";
    slug = "about";
    grid = "sidebar";
    canvasWord = ["Hi, I'm Robin", ";"]


append pre-sidebar
  div.hgroup
    h1
      | Hi, I'm
      |
      +name({full: false})
    p.secondary Hello World!

append sidebar-content
  div.profile-border
    +picture(new ProjectImage({
      name: "profile",
      width: 256,
      height: 256,
      slug: slug,
      alt: "Headshot of Robin de Zwart."
    })).profile-picture

append content
  section#about-me
    +h(2, "About Me")
    p.
      I'm a multi-disciplinary developer with a love for creating interactive experiences and telling stories. I take
      great pride in striving for accessible and responsive design in my work.
    p.
      I've completed a B.Sc. with a primary concentration on #[dfn AI and Data Science for Human-Centered Systems]
      at #[+link("https://www.sfu.ca/siat.html") SFU's School of Interactive Arts &amp; Technology].
      I have also gained experience in web/mobile development, various programming languages, and game design through
      completing additional concentrations.
    p: strong.
      At the end of the day, as long as I'm working on something someone will enjoy or find useful, I'm happy. :]

  section#experience
    +h(2, "Experience")
    p [WIP]

  section#skills
    +h(2, "Skills")
    include inc/_skills
