extends ../layouts/_sidebar

append vars
  -
    title = "Projects"
    slug = "projects"
    description = "Under construction!"
    grid = "pre-sidebar";

append scripts
  script(src="/js/toc.js" defer)


append pre-sidebar
  hgroup.hgroup
    +h(1, "Projects")
    p.secondary Hello world!

append sidebar
  +toc("Projects")
    ol(role="list")
      li: a(href="#machine-learning") Machine Learning
      li: a(href="#game-development") Game Development
      li: a(href="#web-development") Web Development
      li: a(href="#miscellaneous") Miscellaneous

append content
  each category in categories
    section(id=`${category.slug}`)
      +h(2, `${category.displayName}`)

      -
        /** @type {Project[]} */
        let matchingProjects = Object.values(projects).filter(
                (project) => project.category === category
        );

      if matchingProjects.length !== 0
        ul.project-grid(role="list")
          each project in matchingProjects
            +project-card(project)
      else
        p No projects here... yet!
