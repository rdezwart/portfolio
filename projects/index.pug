extends ../layouts/_sidebar

append vars
  -
    title = "Projects"
    slug = "projects"
    description = "Under construction!"
    grid = "pre-sidebar";

append scripts
  script(src="/js/toc.js" defer)


append pre-sidebar
  hgroup.hgroup
    +h(1, "Projects")
    p.secondary Hello world!

append sidebar
  +toc("Projects")
    ol(role="list")
      each category in categories
        li
          a(href=`#${category.slug}`)= category.displayName
          if getMatchingProjects(category).length !== 0
            ol(role="list")
              each project in getMatchingProjects(category)
                li: a(href=`#${project.slug}`)= project.title

append content
  each category in categories
    section(id=`${category.slug}`)
      +h(2, `${category.displayName}`)

      if getMatchingProjects(category).length !== 0
        ul.project-grid(role="list")
          each project in getMatchingProjects(category)
            +project-card(project)
      else
        p No projects here... yet!
