extends ../layouts/_sidebar

append vars
  -
    title = "Projects"
    slug = "projects"
    description = "Under construction!"
    grid = "pre-sidebar";

append scripts
  script(src="/js/toc.js" defer)


append pre-sidebar
  hgroup.hgroup
    +h(1, "Projects")
    p.secondary Hello world!

append sidebar
  +toc("Projects")
    ol(role="list")
      li: a(href="#machine-learning") Machine Learning
      li: a(href="#game-development") Game Development
      li: a(href="#web-development") Web Development
      li: a(href="#miscellaneous") Miscellaneous

append content
  section#machine-learning
    +h(2, "Machine Learning")
    ul.project-grid(role="list")
      +project-card(projects["AutolumeGallery"])
      +project-card(projects["Food Identifier"])

  section#game-development
    +h(2, "Game Development")
    ul.project-grid(role="list")
      +project-card(projects["A Sight Never Seen"])

  section#web-development
    +h(2, "Web Development")


  section#miscellaneous
    +h(2, "Miscellaneous")
