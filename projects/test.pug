include ../inc/_mixins
include ../inc/_project-list

block vars
  -
    let title = "Portfolio"
    let slug = "home"
    let description = "Hi, I'm Robin;"

block page-title
  - let pageTitle = `${title} - Robin de Zwart`

doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(content="width=device-width, initial-scale=1.0" name="viewport")
    title #{pageTitle}
    meta(name="description" content=description)
    meta(name="color-scheme" content="dark light")

    block opengraph
      meta(property="og:title" content=`${pageTitle}`)
      block url
        meta(property="og:url" content=`https://rdezwart.ca/${slug}.html`)
      block image
        meta(property="og:image" content=`https://rdezwart.ca/img/splash/${slug}.png`)
      block image-alt
        meta(property="og:image:alt" content=`Hi, I'm Robin; This is my portfolio.`)
      meta(property="og:description" content=description)
      include ../inc/head/_opengraph

    block styles
      include ../inc/head/_styles
      include ../inc/head/_fontawesome

    block fonts
      include ../inc/head/_fonts

    block favicon
      include ../inc/head/_favicon

    block scripts
      include ../inc/head/_scripts
      script(src="/js/toc.js" defer)

  body
    a(href="#main-content").link.skip Skip to main content

    div.big-wrapper#top
      header.sidebar
        nav.nav(aria-label="Main")
          div.name-wrapper
            a.name(href="/") Robin de&nbsp;Zwart#[span.highlight(aria-hidden="true") ;]
            p.description Interactive Systems Developer
          ul
            li: a(href="/projects/") Projects
            li: a(href="/#about") About

        include ../inc/_social-icons

      main.main#main-content
        article.article
          header.article-header
            hgroup
              +h(1, title)
              p.description #{description}

          +toc()
            ol(role="list")
              li
                a(href="#abstract") Abstract
                ol(role="list")
                  li: a(href="#links") Links
              li: a(href="#examples") Examples
              li: a(href="#introduction") Introduction
              li: a(href="#literature-review") Literature Review
              li: a(href="#system-design") System Design
              li
                a(href="#implementation-details") Implementation Details
                ol(role="list")
                  li: a(href="#vr-hardware") VR Hardware
                  li
                    a(href="#unity") Unity
                    //ol
                    //  li: a(href="#directional-light") Directional Light
                    //  li: a(href="#xr-interaction-manager") XR Interaction Manager
                    //  li: a(href="#osc-manager") OSC Manager
                    //  li: a(href="#xr-origin") XR Origin (XR Rig) Affordance Variant
                    //  li: a(href="#painting") Painting
                    //  li: a(href="#vector-controllers") Vector Controller Left/Right
                    //  li: a(href="#layer-controller") Layer Controller
                    //  li: a(href="#seed-controller") Seed Controller
                    //  li: a(href="#panel-resetter") Panel Resetter
                    //  li: a(href="#environment") Environment
                    //  li: a(href="#camera") Camera
                    //  li: a(href="#quit-listener") QuitListener
                  li: a(href="#autolume-live") Autolume-Live
                li: a(href="#results") Results
                li: a(href="#conclusion") Conclusion
                li: a(href="#ethical-statement") Ethical Statement
                li: a(href="#acknowledgements") Acknowledgements
                li: a(href="#references") References

          div.article-content
            section#abstract
              +h(2, "Abstract")

              p.introduction
                | AutolumeGallery is an interactive virtual gallery space where users can manipulate and explore the latent space
                | of a GAN in 3D. A canvas receives artwork generated in real-time from Autolume-Live, influenced by the position
                | and rotation of several objects in the virtual environment. Users can use these "manipulators" to alter the
                | piece and take an active role in its creation and appearance. The GAN model was trained on the abstract artwork
                | of my late grandfather, Peter John Voormeij, as my way of honouring and connecting with his work.

              section#links
                +h(3, "Links")
                ul.list
                  li Code: #[a.link(href="https://github.com/rdezwart/AutolumeGallery" target="_blank" rel="noreferrer") GitHub]
                  li Paper: #[a.link(href="/files/AutolumeGallery_RobinDeZwart.pdf" target="_blank" rel="noreferrer") View PDF]
                  li Dataset: #[a.link(href="https://voormeij.ca/" target="_blank" rel="noreferrer") Peter John Voormeij]

                div.youtube-container
                  iframe(
                    src="https://www.youtube-nocookie.com/embed/Brn7nG2WOXA?si=ApqnHnHsTaW3ukRk&rel=0&hl=en-ca"
                    title="AutolumeGallery - Demo Video"
                    allow="accelerometer; clipboard-write; encrypted-media; gyroscope; picture-in-picture; web-share"
                    referrerpolicy="strict-origin-when-cross-origin"
                    allowfullscreen
                  )

            section#examples
              +h(2, "Examples")

              a.img-link(href="/img/autolume-gallery/canvas-1.webp" target="_blank")
                img.img(src="/img/autolume-gallery/canvas-1.webp"
                  alt="The Autolume canvas in VR, a mix of greens, yellows, and whites."
                  loading="lazy" width="1920" height="1080")

              div.img-list
                a.img-link(href="/img/autolume-gallery/canvas-2.webp" target="_blank")
                  img.img(src="/img/autolume-gallery/canvas-2.webp" loading="lazy" width="1024" height="1024"
                    alt="A composition saved from AutolumeGallery, primarily oranges and whites.")
                a.img-link(href="/img/autolume-gallery/canvas-3.webp" target="_blank")
                  img.img(src="/img/autolume-gallery/canvas-3.webp" loading="lazy" width="1024" height="1024"
                    alt="A composition saved from AutolumeGallery, primarily blues and greens.")
                a.img-link(href="/img/autolume-gallery/canvas-4.webp" target="_blank")
                  img.img(src="/img/autolume-gallery/canvas-4.webp" loading="lazy" width="1024" height="1024"
                    alt="A composition saved from AutolumeGallery, primarily whites and blues.")
                a.img-link(href="/img/autolume-gallery/canvas-5.webp" target="_blank")
                  img.img(src="/img/autolume-gallery/canvas-5.webp"  loading="lazy" width="1024" height="1024"
                    alt="A composition saved from AutolumeGallery, primarily greens and whites.")

            section#introduction
              +h(2, "Introduction")

              p
                | This project is dedicated to my grandfather, Peter John Voormeij, who passed away in early 2024. He was a Dutch
                | painter and printmaker, and with this "Generative AI and Computational Creativity" course I wanted to explore
                | and honour his abstract artwork in my own way. With the blessing of my family, I constructed a dataset of
                | ~360 works and began brainstorming. I wanted to explore the shapes, patterns, and colours found in his work and
                | create an interactive experience that enables users to do the same.
              p
                | Having recently completed a Unity-based virtual reality course, I found myself wanting to dive deeper and
                | further develop my skills in that area. With an improved understanding of what makes for an engaging experience,
                | I ended up settling on VR for the user interaction half of the project.
              p
                | As the course progressed, it became clear that generative adversarial networks (GANs) would be a powerful
                | option, as they run faster than diffusion models (e.g., Midjourney) and don't require nearly as much data.
                | Essentially, GANs work by pitting two separate neural networks against each other in an arms race: a
                | \emph{generator} network and a \emph{discriminator} network. The generator's job is to create new images from
                | random noise, and the discriminator tries to tell apart the generator's fake output from the real training data.
                | Both networks learn from their mistakes and try to improve at their assigned tasks over time. If everything goes
                | perfectly, the discriminator ends up with a 50\% chance of making the correct prediction, meaning the
                | generator's images are impossible for it to tell apart from the real images.
      footer.footer
        a(href="#top") Back to Top
