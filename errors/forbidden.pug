include ../inc/_mixins

doctype html
html(lang="en")
  head
    title Error 403 - Robin de Zwart
    include ../inc/_boilerplate

    meta(property="og:title" content="Error 403 - Robin de Zwart")
    meta(property="og:url" content="https://rdezwart.ca/errors/forbidden.html")
    meta(property="og:image" content="https://rdezwart.ca/img/splash/error.png")
    meta(property="og:image:alt" content="Hi, I'm Robin; This is an error page.")

  body
    div.content
      main.main
        h1 Error 403#[span.highlight &colon; ] Forbidden

        div
          p Sorry, you don't have permission to access this file.

        nav(aria-label="Main")
          ul.nav-list
            li.nav-item
              div.nav-link-wrapper: a(href="/") #[span.highlight(aria-hidden="true") &gt; ]
                |  Return Home
