include ../inc/_mixins

doctype html
html(lang="en")
  head
    title Error 503 - Robin de Zwart
    include ../inc/_boilerplate

    meta(property="og:title" content="Error 503 - Robin de Zwart")
    meta(property="og:url" content="https://rdezwart.ca/errors/service-unavailable.html")
    meta(property="og:image" content="https://rdezwart.ca/img/splash/error.png")
    meta(property="og:image:alt" content="Hi, I'm Robin; This is an error page.")

  body
    div.content
      nav.side-nav(aria-label="Main")
        div.name-wrapper
          include ../inc/_name
        include ../inc/content/_nav-list
      main.main
        h1 Error 503#[span.highlight &colon; ] Service Unavailable

        div
          p Sorry, the site is down for maintenance at the moment. Check back later!

        nav(aria-label="Main")
          ul.nav-list
            li.nav-item
              div.nav-link-wrapper: a(href="/") #[span.highlight(aria-hidden="true") &gt; ]
                |  Return Home
