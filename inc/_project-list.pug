        new ProjectLink({title: "Original Paper", url: "/files/AutolumeGallery_RobinDeZwart.pdf", text: "View PDF"})
      ],
      tools: ["Unity", "C#", "OSC", "NDI"],
      concepts: ["Virtual Reality", "Creative AI", "Image Generation", "Latent Space"]
    }),

    "Food Identifier": new Project({
      title: "Food Identifier",
