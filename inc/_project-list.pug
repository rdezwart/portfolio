            "Interactive virtual reality system for real-time exploration of generative adversarial network latent space.",
            categories.MACHINE_LEARNING,
            [
              new ProjectLink("Code", "https://github.com/rdezwart/AutolumeGallery", "GitHub"),
              new ProjectLink("Dataset", "https://voormeij.ca/", "Peter John Voormeij"),
              new ProjectLink("Original Paper", "/files/AutolumeGallery_RobinDeZwart.pdf", "View PDF"),
            ],
            ["Unity", "C#", "Open Sound Control", "Network Device Interface"],
            ["Virtual Reality", "Creative AI", "Image Generation", "Latent Space", "Artificial Intelligence"]
    ),
    "Food Identifier": new Project(
            "Food Identifier",
            "food-identifier",
            "Object detection and image captioning for food inside fridges.",
            categories.MACHINE_LEARNING,
            [
              new ProjectLink("Code", "https://huggingface.co/spaces/rdezwart/FoodIdentifier", "HuggingFace")
            ],
            ["Python", "YOLOS", "Moondream"],
            ["Object Recognition", "Image Captioning"]
    ),
    "A Sight Never Seen": new Project(
            "A Sight Never Seen",
            "a-sight-never-seen",
            "Short visual novel with branching paths, set in a world of magic and secrets.",
            categories.GAME_DEVELOPMENT,
            [
