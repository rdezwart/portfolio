-
  /**
   * Helper class to easily format project-related links.
   */
  class ProjectLink {
    /**
     * @param {string} title - The text to be inserted ahead of the link,
     *     followed by a colon.
     * @param {string} url - The URL this link points to.
     * @param {string} text - The text to be placed inside the anchor.
     * @param {string} attrs - Any other attributes to add to the anchor.
     */
    constructor(
            title = undefined,
            url = "#",
            text = "Link",
            attrs = 'target="_blank" rel="noopener noreferrer"'
    ) {
      this.title = title;
      this.url = url;
      this.text = text;
      this.attrs = attrs;
    }

    /**
     * @returns {string} - Formatted title, URL, and text.
     */
    toString() {
      let _title = this.title ? `<strong>${this.title}:</strong> ` : ``;

      return `${_title}<a href="${this.url}" ${this.attrs}>${this.text}</a>`;
    }
  }

  /**
   * Represents a category a {@link Project} may belong to.
   */
  class ProjectCategory {
    /**
     * @param {string} displayName - The display name of this category.
     * @param {string} slug - The slug of this category.
     */
    constructor(displayName, slug) {
      this.displayName = displayName;
      this.slug = slug;
    }
  }

  /**
   * Contains the display name and slug for each project category, listed in
   * display order.
   * @readonly
   * @enum {ProjectCategory}
   */
  const categories = {
    MACHINE_LEARNING: new ProjectCategory("Machine Learning", "machine-learning"),
    GAME_DEVELOPMENT: new ProjectCategory("Game Development", "game-development"),
    WEB_DEVELOPMENT: new ProjectCategory("Web Development", "web-development"),
    MISCELLANEOUS: new ProjectCategory("Miscellaneous", "miscellaneous"),
  }


  /**
   * Contains information about my projects.
   */
  class Project {
    /**
     * @param {string} title
     * @param {string} slug
     * @param {string} description
     * @param {ProjectCategory} category
     * @param {ProjectLink[]} links
     * @param {string[]} tools
     * @param {string[]} concepts
     */
    constructor(
            title = "Portfolio",
            slug = "home",
            description = "Hi, I'm Robin;",
            category = categories.MISCELLANEOUS,
            links = [],
            tools = [],
            concepts = [],
    ) {
      this.title = title;
      this.slug = slug;
      this.description = description;
      this.category = category;
      this.links = links;
      this.tools = tools;
      this.concepts = concepts;
    }
  }

  const projects = {
    "AutolumeGallery": new Project(
            "AutolumeGallery",
