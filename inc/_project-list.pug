-
  /**
   * Helper class to easily format project-related links.
   */
  class ProjectLink {
    /**
     * @param {Object} [options] - Object literal with configuration information.
     * @param {string} [options.title] - The text to be inserted ahead of the link,
     *     followed by a colon.
     * @param {string} [options.url] - The URL this link points to.
     * @param {string} [options.text] - The text to be placed inside the anchor.
     * @param {string} [options.attrs] - Any other attributes to add to the anchor.
     */
    constructor(
            {
              title = undefined,
              url = "#",
              text = "Link",
              attrs = 'rel="external noreferrer"'
            } = {}
    ) {
      this.title = title;
      this.url = url;
      this.text = text;
      this.attrs = attrs;
    }

    /**
     * @returns {string} - Formatted title, URL, and text.
     */
    toString() {
      let _title = this.title ? `<strong>${this.title}:</strong> ` : ``;

      return `${_title}<a href="${this.url}" ${this.attrs}>${this.text}</a>`;
    }
  }

  /**
   * Represents a category a {@link Project} may belong to.
   */
  class ProjectCategory {
    /**
     * @param {string} displayName - The display name of this category.
     * @param {string} slug - The slug of this category.
     */
    constructor(displayName, slug) {
      this.displayName = displayName;
      this.slug = slug;
    }
  }

  /**
   * Parameters to be passed to {@link ProjectImage}.
   * @typedef ProjectImageOptions
   * @property {string} [name]
   * @property {string} [slug]
   * @property {number} [width]
   * @property {number} [height]
   * @property {string} [alt]
   * @property {string} [primaryFormat]
   * @property {string} [fallbackFormat]
   * @property {string} [loading]
   * @property {boolean} [small]
   */

  /**
   * Represents the image associated with a {@link Project}.
   */
  class ProjectImage {
    /**
     * @param {ProjectImageOptions} [options] - {@link ProjectImageOptions}
     *     containing options for creating this `ProjectImage`.
     */
    constructor(
            {
              name = "banner",
              slug = (typeof currentProject !== 'undefined') ? currentProject.slug : "",
              width = 512,
              height = 512,
              alt = "",
              primaryFormat = "webp",
              fallbackFormat = "jpeg",
              loading = "lazy",
              small = true
            } = {}
    ) {
      this.name = name;
      this.slug = (slug.length > 0 && slug.slice(-1) !== "/") ? `${slug}/` : slug;
      this.width = width;
      this.height = height;
      this.alt = alt;
      this.primaryFormat = primaryFormat;
      this.fallbackFormat = fallbackFormat;
      this.loading = loading;
      this.small = small;
    }
  }

  /**
   * Contains the display name and slug for each project category, listed in
   * display order.
   * @readonly
   * @enum {ProjectCategory}
   */
  const categories = {
    MACHINE_LEARNING: new ProjectCategory("Machine Learning", "machine-learning"),
    GAME_DEVELOPMENT: new ProjectCategory("Game Development", "game-development"),
    WEB_DEVELOPMENT: new ProjectCategory("Web Development", "web-development"),
    MISCELLANEOUS: new ProjectCategory("Miscellaneous", "miscellaneous")
  };


  /**
   * Contains information about my projects.
   */
  class Project {
    /**
     * @param {Object} [options] - Object literal with configuration information.
     * @param {string} [options.title] - The title of this project.
     * @param {string} [options.slug] - The base slug of this project.
     * @param {string} [options.description] - The description of this project.
     * @param {ProjectCategory} [options.category] - The category this project belongs to.
     * @param {ProjectImageOptions} [options.imageOptions] - The image options to use for this project's banner.
     * @param {ProjectLink[]} [options.links] - Links associated to this project.
     * @param {string[]} [options.tools] - Tools used in this project.
     * @param {string[]} [options.concepts] - Concepts involved in this project.
     */
    constructor(
            {
              title = "Portfolio",
              slug = "home",
              description = "Hi, I'm Robin;",
              category = categories.MISCELLANEOUS,
              imageOptions = {},
              links = [],
              tools = [],
              concepts = []
            } = {}
    ) {
      this.title = title;
      this.slug = slug;
      this.description = description;
      this.category = category;

      /* By inserting a default slug here, we avoid accessing `currentProject`
       in this scope ENTIRELY (normally used as the default value when creating
       a ProjectImage). This is ideal since it's not initialized yet at this
       point, and would throw an error if we tried. */
      this.image = new ProjectImage({slug: this.slug, ...imageOptions});

      this.links = links;
      this.tools = tools;
      this.concepts = concepts;
    }
  }

  const projects = {
