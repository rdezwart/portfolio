//- Originally wanted to have separate files for each mixin and include them where needed, but I found a bug that
  caused excessive indentation when mixins were included anywhere OTHER than the very top of the file.
  Figured it easiest to have them all in one file for this.

//- Webstorm's PUG parser has issues. It doesn't recognize that default value assignment is valid syntax.
  Documentation: https://pugjs.org/language/mixins.html#default-arguments-values
  Bug report from 5(!!) years ago: https://youtrack.jetbrains.com/issue/WEB-38623/

mixin nav-item(category, text, link, desc)
  li.nav-item
    div.nav-link-wrapper: a(href=link) #[span.highlight(aria-hidden="true") &gt; ]
      | #[span.highlight &lbrack;]#{category}#[span.highlight &rbrack;] #{text}
    if desc
      p.description #{desc}


//- Mixin for generating styled headings.
  Referenced: https://stackoverflow.com/a/56565423
  Note: `attributes` is an implicit argument passed to the mixin, WebStorm
  doesn't quite recognize it.
mixin h(level, heading = "", doArrows = true, levelOverride = -1)
  -
    let visualLevel = levelOverride !== -1 ? levelOverride : level;
    visualLevel = Math.max(1, Math.min(6, visualLevel));

    let arrows = ">".repeat(visualLevel - 1);
    if (arrows !== "") arrows += " ";

  //- There's a cleaner way of doing this conditional, but this avoids weird extra newlines
  //- Add styling class based on visual level, can be different from actual level
  if doArrows && arrows !== ""
    #{"h" + level}(class=`${"h" + visualLevel}`)&attributes(attributes)
      | #[span.highlight(aria-hidden="true") #{arrows}]!{heading}
  else
    #{"h" + level}(class=`${"h" + visualLevel}`)&attributes(attributes)
      | !{heading}

  if block
    block


//- IMPORTANT: Must be a child of a ".name-wrapper"
mixin fancy-name(fancy = false)
  span.name(data-fancy=fancy)
    if fancy
      a.link(href="/") Robin
        span.visually-hidden  de Zwart;
        span.letters(aria-hidden="true")
          | #[span  ]
          span d
          span e
          | #[span  ]
          span Z
          span w
          span a
          span r
          span t
    else
      a.link(href="/") Robin de Zwart
    | #[span.highlight(aria-hidden="true") ;]


//- Shortcut for name, also prevents breaking between my last name
  Double child spans is for allowing the link text to get decoration, but not
  the highlight.
mixin name({full=true, highlight=true} = {})
  a.name(href="/")
    if full
      span Robin de&nbsp;Zwart
    else
      span Robin

    if highlight
      span.highlight ;


//- Modifies `+sidebar()` for TOC-specific features
mixin toc(options = {})
  -
    const {
      heading = "Table of Contents",
      headingID = "toc-heading",
    } = options;

  +sidebar({heading, headingID})(class="sticky toc")&attributes(attributes)
    nav.nav(aria-labelledby="toc-heading")
      block

//- Generic sidebar mixin, meant to be wrapped in a `.sidebar-wrapper`
mixin sidebar(options = {})
  -
    const {
      heading = "Sidebar",
      headingID = undefined,
      toTopButton = false,
    } = options;

  section.sidebar&attributes(attributes)
    +h(2, heading, false, 4)(class="sidebar-heading" id=headingID)
    div.scrollable
      block
    if toTopButton
      a.to-top(href="#")
        span Back to Top
        span.highlight ;


//- Renders a list of items, with extra cases for a comma separated list
mixin list(items = [], type="ul")
  - let addCommas = attributes.class?.includes("comma-list");

  #{type}&attributes(attributes)
    each item, index in items
      li!= addCommas && index < items.length - 1 ? `${item.toString()}, ` : item.toString()


mixin project-card(project)
  li.project-card(id=`${project.slug}`)
    h3.project-heading
      a(href=`/projects/${project.slug}.html`)!= project.title

    div.project-details
      div.project-desc
        p.description= project.description
      div.project-tools
        +list(project.tools)(class="tools" role="list")

    +picture(project.image).project-img


//- Quick helper for links to external pages
mixin link(url)
  a(href=url, rel="external noreferrer")&attributes(attributes)
    if block
      block
    else
      = url
    span.visually-hidden  (external link)


//- Handles automatic ID assignment to figures/examples/other counters
mixin figure(options = {})
  -
    const {
      counterName = "Figure"
    } = options;
    counters[counterName]++;

  figure(id=`${counterName.toLowerCase()}-${counters[counterName]}`)
    block


//- Creates an anchor to a specific figure, by number
mixin figure-link(figNumber, text="Figure")
  a(href=`#${text.toLowerCase()}-${figNumber}`) #{text} #{figNumber}


//- Creates a figcaption with an auto-generated figure number. The count is per
    page.
mixin figcaption(hiResName, options = {})
  -
    const {
      project = currentProject,
      counterName = "Figure",
    } = options;

  figcaption
    strong
      | #{counterName} #{counters[counterName]}
      if hiResName
        |  (
        +hi-res-label(hiResName, options)
        | )
      if block
        = ": "
    block


//- Inserts a standard link for the highest resolution version of an image,
  one that usually won't be loaded onto the page directly.
mixin hi-res-label(name, options = {})
  -
    const {
      project = currentProject,
    } = options;

  a(href=`/img/${project.slug}/${name}.png`) Hi-Res


//- Expects webp and fallback images to exist, including smaller versions for
  different pixel densities.
  ProjectImage ensures slugs have an ending slash, if necessary.
mixin picture(/** @type {ProjectImage} */ image)
  picture&attributes(attributes)
    if image.small
      source(srcset=`/img/${image.slug}${image.name}-sm.${image.primaryFormat} 1x,
          /img/${image.slug}${image.name}.${image.primaryFormat} 2x` type=`image/${image.primaryFormat}`)

      img(srcset=`/img/${image.slug}${image.name}-sm.${image.fallbackFormat} 1x,
          /img/${image.slug}${image.name}.${image.fallbackFormat} 2x`
        src=`/img/${image.slug}${image.name}-sm.${image.fallbackFormat}` loading=`${image.loading}`
        width=`${image.width}` height=`${image.height}`
        alt=`${image.alt}`)

    else
      if image.primaryFormat !== image.fallbackFormat
        source(srcset=`/img/${image.slug}${image.name}.${image.primaryFormat} 1x` type=`image/${image.primaryFormat}`)

      img(srcset=`/img/${image.slug}${image.name}.${image.fallbackFormat} 1x`
        src=`/img/${image.slug}${image.name}.${image.fallbackFormat}` loading=`${image.loading}`
        width=`${image.width}` height=`${image.height}`
        alt=`${image.alt}`)

//- Quick helper to pair an in-text citation with a proper time object.
mixin citation(name, time)
  != `${name}, <time datetime="${time}">${time}</time>`
