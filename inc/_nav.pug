header.nav-wrapper
  nav.nav(aria-label="Main")
    div.name-wrapper
      +name()
      p.description AI &amp; Interactive Systems Developer
    ul
      li
        a(href="/projects/") Projects
        ul
          each category in categories
            li: a(href=`/projects/#${category.slug}`)= category.displayName
      li: a(href="/about.html") About

  include _social-icons
