header.nav-wrapper
  nav.nav(aria-label="Main")
    div.name-wrapper
      +name()
      p.description AI &amp; Interactive Systems Developer
    ul
      li(class={current: slug === "projects"})
        a(href="/projects/") Projects
        ul
          each category in categories
            li(class={
              current: (currentProject && currentProject.category === category)
            })
              a(href=`/projects/#${category.slug}`)= category.displayName
      li(class={current: slug === "about"})
        a(href="/about.html") About

  include _social-icons
