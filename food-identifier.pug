include inc/_mixins

doctype html
html(lang="en")
  head
    title Food Identifier - Robin de Zwart
    include inc/_boilerplate

    meta(property="og:title" content="Food Identifier - Robin de Zwart")
    meta(property="og:type" content="website")
    meta(property="og:locale" content="en_CA")
    meta(property="og:url" content="https://rdezwart.ca/food-identifier.html")
    meta(property="og:image" content="https://rdezwart.ca/img/splash/food-identifier.png")
    meta(property="og:description" content="Object detection and image captioning for food inside fridges.")

    script(type="module" src="https://gradio.s3-us-west-2.amazonaws.com/4.26.0/gradio.js" defer)

  body
    div.content
      nav.side-nav(aria-label="Main")
        div.name-wrapper
          include inc/_name
        include inc/content/_nav-list
      main.main
        include inc/content/_food-identifier
