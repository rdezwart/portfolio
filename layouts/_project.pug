extends _sidebar

append vars
  -
    let project = new Project();
    automata = false;

prepend page-title
  -
    title = project.title
    slug = project.slug
    description = project.description

block url
  meta(property="og:url" content=`https://rdezwart.ca/projects/${slug}.html`)

block image-alt
  meta(property="og:image:alt" content=`Hi, I'm Robin; This is my project, ${title}.`)

append scripts
  script(src="/js/toc.js" defer)

block main
  article.article(style=`--project-banner: url('/img/${slug}/banner.webp');`)
    header.header
      block header
        block hgroup
          hgroup.hgroup
            +h(1, title)
            p.description #{description}
        div.gradient
        if project.links.length > 0
          +list(project.links)(class="links" role="list")

    div.sidebar-wrapper
      block sidebar
        +toc()
          ol(role="list")
            block toc
              li: a(href="#overview") Overview

    div.content
      block content
        section#overview
          +h(2, "Overview")
            block overview
              if project.tools.length > 0
                p: strong Tools:
                +list(project.tools)(class="tools" role="list")
              if project.concepts.length > 0
                p: strong Concepts:
                +list(project.concepts)(class="concepts" role="list")
