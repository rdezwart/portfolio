extends _default

append vars
  -
    let project = new Project()

prepend page-title
  -
    title = project.title
    slug = project.slug
    description = project.description

block url
  meta(property="og:url" content=`https://rdezwart.ca/projects/${slug}.html`)

block image-alt
  meta(property="og:image:alt" content=`Hi, I'm Robin; This is my project, ${title}.`)

append scripts
  script(src="/js/toc.js" defer)

block main
  article.article
    header.header
      block header
        hgroup
          +h(1, title)
          p.description #{description}

    +toc()
      ol(role="list")
        block toc

    div.content
      block content

append footer
  a(href="#top") Back to Top
