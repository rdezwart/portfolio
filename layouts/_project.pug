extends _sidebar

append vars
  -
    let currentProject = new Project();
    automata = false;

prepend page-title
  -
    title = currentProject.rawTitle
    slug = currentProject.slug
    description = currentProject.description

block url
  meta(property="og:url" content=`https://rdezwart.ca/projects/${slug}.html`)

block image-alt
  meta(property="og:image:alt" content=`Hi, I'm Robin; This is my project, ${title}.`)

append scripts
  script(src="/js/toc.js" defer)

block main
  article.article(style=`--project-banner: url('/img/${slug}/${currentProject.image.name}.webp');`)
    header.header
      block header
        block hgroup
          hgroup.hgroup
            +h(1, currentProject.title)
            p.description #{description}
        div.gradient
        if currentProject.links.length > 0
          +list(currentProject.links)(class="links" role="list")

    div.sidebar-wrapper
      block sidebar-content
        +toc()
          ol(role="list")
            block toc
              li: a(href="#overview") Overview

    div.content
      block content
        section#overview
          +h(2, "Overview")
            block overview
              if currentProject.tools.length > 0
                p: strong Tools:
                +list(currentProject.tools)(class="tools" role="list")
              if currentProject.concepts.length > 0
                p: strong Concepts:
                +list(currentProject.concepts)(class="concepts" role="list")
