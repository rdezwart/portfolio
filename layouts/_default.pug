include ../inc/_mixins
include ../inc/_helpers
include ../inc/_project-list

block vars
  -
    let title = "Portfolio";
    let slug = "home";
    let description = "Hi, I'm Robin; I'm a multi-disciplinary developer with a love for creating interactive " +
            "experiences and telling stories.";
    let grid = "default";
    let automata = true;
    let canvasWord = ['Hello there', '!'];
    let counters = {"Figure" : 0, "Example" : 0};

block page-title
  -
    let pageTitle = `${title} - Robin de Zwart`
    let _canvasText = canvasWord[0];
    let _canvasHighlight = canvasWord[1];

doctype html
html(lang="en")
  head
    block meta
      meta(charset="UTF-8")
      meta(content="width=device-width, initial-scale=1.0, viewport-fit=cover" name="viewport")
      title= pageTitle
      meta(name="description" content=description)
      meta(name="color-scheme" content="dark light")

    block opengraph
      meta(property="og:title" content=`${pageTitle}`)
      block url
        meta(property="og:url" content=`https://rdezwart.ca/${slug}.html`)
      block image
        meta(property="og:image" content=`https://rdezwart.ca/img/splash/${slug}.png`)
      block image-alt
        meta(property="og:image:alt" content=`Hi, I'm Robin; This is my portfolio.`)
      meta(property="og:description" content=description)
      include ../inc/head/_opengraph

    block styles
      include ../inc/head/_styles
      include ../inc/head/_fontawesome

    block fonts
      include ../inc/head/_fonts

    block favicon
      include ../inc/head/_favicon

    block scripts
      include ../inc/head/_scripts
      if automata
        include ../inc/head/_automata

  body
    a(href="#main-content").skip Skip to main content

    div(class=`wrapper grid grid-${grid}`)
      include ../inc/_nav

      main.main#main-content
        block main
          div.header
            p.canvas-fallback #{_canvasText}#[span.highlight #{_canvasHighlight}]

            if automata
              div#automata-wrapper(
                data-canvas-text=`${_canvasText}`
                data-canvas-highlight=`${_canvasHighlight}`
              )
              noscript Enable JavaScript for an interactive canvas banner!

          block sidebar

          div.content
            block content

      footer.footer
        div.footer-contents
          block footer
            a.button(href="#") Back to Top
            p.secondary Made by hand with love.
            include ../inc/_social-icons
